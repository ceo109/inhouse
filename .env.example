# Resend: emails each lead to the sales inbox. Get a key at https://resend.com/api-keys
RESEND_API_KEY=
# Who receives leads (comma-separate for several addresses).
LEAD_TO_EMAIL=ceo@inhouseprojects.in,rishi@mantraitsolutions.in
# Sender. Must be on a domain verified in Resend (inhouseprojects.online is). Defaults to this if empty.
LEAD_FROM_EMAIL="Inhouse Villas <leads@inhouseprojects.online>"

# Optional: also POST each lead as JSON to a CRM, Zapier, Google Apps Script, etc.
LEAD_WEBHOOK_URL=
